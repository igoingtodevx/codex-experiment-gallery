# Server-only. Never expose this value to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Optional hard ceiling for the public demo.
MAX_REQUEST_BYTES=1500000
# Optional: when set, the /api/experiments/:slug route requires
# `Authorization: Bearer <PROVIDER_API_KEY>`. Leave empty for no auth.
PROVIDER_API_KEY=
